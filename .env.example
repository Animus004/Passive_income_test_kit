# ==============================================================================
# Autonomous Video Agent & Social Distribution Engine - Environment Template
# ==============================================================================
# Copy this file to .env and populate your active credentials.
# All pipelines gracefully fall back to local/mock alternatives where possible.

# ------------------------------------------------------------------------------
# 1. Multi-Agent LLM Cluster (Google Gemini & Fallbacks)
# ------------------------------------------------------------------------------
# Primary Google Gemini API Key (Required for baseline Showrunner/Coder)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Dedicated Concurrency Pool Keys (Optional: isolates rate limits between agents)
GEMINI_KEY_SHOWRUNNER=your_gemini_api_key_for_showrunner
GEMINI_MODEL_SHOWRUNNER=gemini-2.5-flash

GEMINI_KEY_CODER=your_gemini_api_key_for_coder
GEMINI_MODEL_CODER=gemini-2.5-flash

GEMINI_KEY_DEBUGGER=your_gemini_api_key_for_debugger
GEMINI_MODEL_DEBUGGER=gemini-2.5-flash

# Secondary LLM Providers (Failover for HTTP 429 quota exhaustion)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# ------------------------------------------------------------------------------
# 2. Text-to-Speech (TTS) Voice Synthesis Engines
# ------------------------------------------------------------------------------
# Selected TTS Engine: kokoro (offline neural), elevenlabs, or edge-tts
TTS_ENGINE=kokoro

# ElevenLabs (Optional: premium natural narration with word-level alignment)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Edge-TTS (Free Microsoft Neural fallback)
TTS_VOICE=en-US-ChristopherNeural

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 & OAuth 2.0
# ------------------------------------------------------------------------------
# Phase 1 YouTube Channel
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_PRIVACY_STATUS=public
# OAuth credentials generated via scripts/auth_phase1.js or Google Cloud Console
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Meta Graph API v21.0 (Instagram Reels & Facebook Pages)
# ------------------------------------------------------------------------------
# Phase 1 Channels
INSTAGRAM_USER_ID=your_phase1_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_phase1_instagram_user_access_token
FACEBOOK_PAGE_ID=your_phase1_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_phase1_facebook_page_access_token

# Phase 2 Channels
PHASE2_INSTAGRAM_USER_ID=your_phase2_instagram_business_account_id
PHASE2_INSTAGRAM_ACCESS_TOKEN=your_phase2_instagram_access_token
PHASE2_FACEBOOK_PAGE_ID=your_phase2_facebook_page_id
PHASE2_FACEBOOK_PAGE_ACCESS_TOKEN=your_phase2_facebook_page_access_token

# ------------------------------------------------------------------------------
# 5. Telegram Bot & Notification Pipeline
# ------------------------------------------------------------------------------
# Sends automated publication alerts, preview videos, and 1-tap mobile captions
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 6. X (Twitter) Developer API v2 & OAuth 1.0a
# ------------------------------------------------------------------------------
X_API_KEY=your_x_consumer_key
X_API_SECRET=your_x_consumer_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_BEARER_TOKEN=your_x_bearer_token

# ------------------------------------------------------------------------------
# 7. Reddit API (Script / Password Grant)
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_app_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=node:com.aiengine.shorts:v1.0.0

# ------------------------------------------------------------------------------
# 8. 3D Model Repositories & Stock APIs
# ------------------------------------------------------------------------------
SKETCHFAB_API_KEY=your_sketchfab_api_token_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
COVERR_API_KEY=your_coverr_api_key_here
