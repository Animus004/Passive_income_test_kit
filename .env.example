# ==============================================================================
# Programmatic Shorts Generator Environment Configuration
# ==============================================================================

# Gemini AI API Key (Required for script generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud OAuth 2.0 Credentials (for YouTube Data API v3 upload)
# Set these in your local .env or GitHub Actions Repository Secrets
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# Optional: Meta Graph API Credentials (for Instagram Reels auto-posting)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Microsoft Neural Voice (Free via edge-tts)
# Options: en-US-ChristopherNeural, en-US-GuyNeural, en-US-EricNeural, en-GB-RyanNeural
TTS_VOICE=en-US-ChristopherNeural

# Monetization & Passive Income Levers
MONETIZATION_AFFILIATE_URL=https://bit.ly/data-detective-tools
MONETIZATION_NEWSLETTER_URL=https://datadetective.substack.com
