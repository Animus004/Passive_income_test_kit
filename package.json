{
  "name": "shorts-generator",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.542",
    "@remotion/three": "4.0.542",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.10",
    "googleapis": "^189.0.0",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "roughjs": "^4.6.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:daily": "node scripts/daily_run.js",
    "publish:all": "node scripts/publish_all.js",
    "dev": "remotion studio",
    "generate-audio": "node scripts/generate_audio.js",
    "render": "remotion render src/index.ts ShortVideo out/final_short.mp4",
    "render:style-advisor": "remotion render src/index.ts StyleAdvisor out/style_advisor_short.mp4",
    "render:data-detective": "remotion render src/index.ts DataDetective out/data_detective_short.mp4",
    "build-short": "node scripts/run_pipeline.js",
    "auth:phase1": "node scripts/auth_phase1.js",
    "auth:phase2": "node scripts/auth_phase2.js",
    "relatable:daily": "node scripts/run_relatable_autonomous.js --lang en --publish",
    "relatable:run": "node scripts/run_relatable_autonomous.js --lang en",
    "whatif:run": "node scripts/autonomous_whatif_runner.js",
    "whatif:publish": "node scripts/publish_whatif.js",
    "oddly:run": "node scripts/run_oddly_autonomous.js",
    "oddly:daily": "node scripts/run_oddly_autonomous.js",
    "oddly:schedule": "powershell -ExecutionPolicy Bypass -File scripts/setup_phase1_scheduler.ps1",
    "oddly:watchdog": "node scripts/oddly_watchdog.js",
    "factory:status": "node --no-warnings scripts/factory_orchestrator.mjs --mode status",
    "factory:produce": "node --no-warnings scripts/factory_orchestrator.mjs --mode produce",
    "factory:publish": "node --no-warnings scripts/factory_orchestrator.mjs --mode publish --social",
    "factory:schedule": "powershell -ExecutionPolicy Bypass -File scripts/setup_phase1_scheduler.ps1",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
