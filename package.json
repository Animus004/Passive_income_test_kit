{
  "name": "shorts-generator",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@remotion/cli": "4.0.542",
    "dotenv": "^18.0.10",
    "googleapis": "^189.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:daily": "node scripts/daily_run.js",
    "publish:all": "node scripts/publish_all.js",
    "dev": "remotion studio",
    "generate-audio": "node scripts/generate_audio.js",
    "render": "remotion render src/index.ts ShortVideo out/final_short.mp4",
    "render:style-advisor": "remotion render src/index.ts StyleAdvisor out/style_advisor_short.mp4",
    "render:data-detective": "remotion render src/index.ts DataDetective out/data_detective_short.mp4",
    "build-short": "node scripts/run_pipeline.js",
    "auth": "node scripts/upload_youtube.js --auth-only",
    "upload": "node scripts/upload_youtube.js",
    "auto-publish": "node scripts/auto_publish.js",
    "schedule": "node scripts/scheduler.js",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
